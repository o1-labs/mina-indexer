# Copy to `.env` and adjust. `docker compose` reads it automatically.

# Upstream GraphQL the guardian proxies to. Defaults target a Mina NODE on the
# host at the node's default GraphQL port (3085). Point this at the indexer
# (e.g. MINA_NODE_GRAPHQL_PORT=8080) or a container (MINA_NODE_HOST=<service>).
MINA_NODE_HOST=host.docker.internal
MINA_NODE_GRAPHQL_PORT=3085

# Port the guardian itself listens on — point your clients here.
GUARDIAN_PORT=8080
